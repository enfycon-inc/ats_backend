  @@map("recipients")
  @@schema("mass_mail")
}

model EmailPreference {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String?       @map("tenant_id") @db.Uuid
  actionName     String        @unique @map("action_name") @db.VarChar(255)
  emailAccountId String?       @map("email_account_id") @db.Uuid
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id])

  @@map("email_preferences")
  @@schema("mass_mail")
}

model DeliverySettings {
  tenantId       String   @map("tenant_id") @db.Uuid
  branchId       String   @default("default") @map("branch_id") @db.VarChar(255)
  ratePerMinute  Int      @default(30) @map("rate_per_minute")
  ratePerHour    Int      @default(500) @map("rate_per_hour")
  randomizeDelay Boolean  @default(false) @map("randomize_delay")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, branchId])
  @@map("delivery_settings")
  @@schema("mass_mail")
}

model EmailTemplate {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String   @db.VarChar(255)
  subject   String?  @db.VarChar(255)
  body      String?
  createdBy String?  @map("created_by") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("templates")
  @@schema("mass_mail")
}
