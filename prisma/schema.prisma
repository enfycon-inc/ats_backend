generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ats", "mass_mail"]
}

model Tenant {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                      String                 @db.VarChar(255)
  domain                    String?                @unique @db.VarChar(255)
  status                    String                 @default("ACTIVE") @db.VarChar(50)
  defaultMarket             String                 @default("US") @map("default_market") @db.VarChar(50)
  userLimit                 Int                    @default(5) @map("user_limit")
  prefixCode                String?                @unique @map("prefix_code") @db.VarChar(10)
  podSystemEnabled          Boolean                @default(true) @map("pod_system_enabled")
  maxBranches               Int                    @default(5) @map("max_branches")
  candidatePoolMode         String                 @default("COMBINED_MARKET") @map("candidate_pool_mode") @db.VarChar(50)
  emailDispatchMode         String                 @default("DEFAULT_SUBDOMAIN") @map("email_dispatch_mode") @db.VarChar(50)
  customEmailDomain         String?                @map("custom_email_domain") @db.VarChar(255)
  customEmailDomainVerified Boolean                @default(false) @map("custom_email_domain_verified")
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobAssignmentOptions      Json?                  @default("{}") @map("job_assignment_options")
  jobAssignmentMode         String?                @default("AUTO") @map("job_assignment_mode") @db.VarChar(50)
  jobCodePattern            String?                @default("{BRANCH}-{UNIT}-{YYMMDD}-{SEQ}") @map("job_code_pattern") @db.VarChar(200)
  enforceJobCodePattern     Boolean                @default(false) @map("enforce_job_code_pattern")
  auditLogs                 AuditLog[]
  branches                  Branch[]
  bulkUploads               BulkUpload[]
  businessUnits             BusinessUnit[]
  candidates                Candidate[]
  clients                   Client[]
  customRoles               CustomRole[]
  jobAssignmentLogs         JobAssignmentLog[]
  delegationRequests        JobDelegationRequest[]
  jobs                      Job[]
  marketSegments            MarketSegment[]
  notifications             Notification[]
  pods                      Pod[]
  submissions               RecruiterSubmission[]
  tenantAuthSettings        TenantAuthSettings?
  tenantCounters            TenantCounters[]
  diceIntegration           TenantDiceIntegration?
  tenantDomains             TenantDomain[]
  tenantEmailDomains        TenantEmailDomain[]
  userInvitations           UserInvitation[]
  users                     User[]

  @@map("tenants")
  @@schema("ats")
}

model TenantCounters {
  tenantId     String @map("tenant_id") @db.Uuid
  entityType   String @map("entity_type") @db.VarChar(50)
  currentValue Int    @default(0) @map("current_value")
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, entityType])
  @@map("tenant_counters")
  @@schema("ats")
}

model TenantDomain {
  id                 Int       @id @default(autoincrement())
  tenantId           String    @map("tenant_id") @db.Uuid
  domainName         String    @unique @map("domain_name") @db.VarChar(255)
  isPrimary          Boolean   @default(false) @map("is_primary")
  verificationToken  String?   @map("verification_token") @db.VarChar(255)
  verificationStatus String    @default("VERIFIED") @map("verification_status") @db.VarChar(50)
  sslStatus          String    @default("ACTIVE") @map("ssl_status") @db.VarChar(50)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_domains")
  @@schema("ats")
}

model TenantAuthSettings {
  tenantId              String   @id @map("tenant_id") @db.Uuid
  allowPasswordLogin    Boolean  @default(true) @map("allow_password_login")
  allowMicrosoftSso     Boolean  @default(false) @map("allow_microsoft_sso")
  allowGoogleSso        Boolean  @default(false) @map("allow_google_sso")
  enforceSsoOnly        Boolean  @default(false) @map("enforce_sso_only")
  requireMfa            Boolean  @default(false) @map("require_mfa")
  allowPersonalEmails   Boolean  @default(true) @map("allow_personal_emails")
  allowedEmailDomains   String[] @default([]) @map("allowed_email_domains")
  microsoftTenantId     String?  @map("microsoft_tenant_id") @db.VarChar(255)
  microsoftClientId     String?  @map("microsoft_client_id") @db.VarChar(255)
  microsoftClientSecret String?  @map("microsoft_client_secret") @db.VarChar(255)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_auth_settings")
  @@schema("ats")
}

model TenantEmailDomain {
  id            Int       @id @default(autoincrement())
  tenantId      String    @map("tenant_id") @db.Uuid
  emailDomain   String    @unique @map("email_domain") @db.VarChar(255)
  senderAddress String    @map("sender_address") @db.VarChar(255)
  dkimTokens    String[]  @default([]) @map("dkim_tokens")
  dkimVerified  Boolean   @default(false) @map("dkim_verified")
  spfVerified   Boolean   @default(false) @map("spf_verified")
  status        String    @default("PENDING") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_email_domains")
  @@schema("ats")
}

model TenantDiceIntegration {
  tenantId       String    @id @map("tenant_id") @db.Uuid
  clientId       String?   @map("client_id") @db.VarChar(255)
  clientSecret   String?   @map("client_secret")
  accountId      String?   @map("account_id") @db.VarChar(255)
  accessToken    String?   @map("access_token")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)
  isActive       Boolean   @default(true) @map("is_active")
  dailyViewLimit Int       @default(500) @map("daily_view_limit")
  viewsUsedToday Int       @default(0) @map("views_used_today")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_dice_integrations")
  @@schema("ats")
}

model Branch {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String                 @map("tenant_id") @db.Uuid
  name                       String                 @db.VarChar(255)
  code                       String?                @db.VarChar(50)
  city                       String?                @db.VarChar(100)
  state                      String?                @db.VarChar(100)
  country                    String                 @default("India") @db.VarChar(100)
  isActive                   Boolean                @default(true) @map("is_active")
  market                     String                 @default("INDIA") @db.VarChar(50)
  allowNone                  Boolean                @default(false) @map("allow_none")
  allowPods                  Boolean                @default(true) @map("allow_pods")
  allowAll                   Boolean                @default(true) @map("allow_all")
  allowUnassigned            Boolean                @default(true) @map("allow_unassigned")
  podDistributionStrategy    String                 @default("AUTO") @map("pod_distribution_strategy") @db.VarChar(50)
  requireAmJobApproval       Boolean                @default(true) @map("require_am_job_approval")
  requireJobApproval         Boolean                @default(true) @map("require_job_approval")
  rolesRequiringApproval     String?                @map("roles_requiring_approval")
  defaultJobApproverRole     String?                @default("POD_LEAD") @map("default_job_approver_role") @db.VarChar(50)
  allowedJobApproverRoles    String?                @map("allowed_job_approver_roles")
  approvalRoutingMode        String?                @default("FLEXIBLE") @map("approval_routing_mode") @db.VarChar(50)
  timezone                   String?                @default("Asia/Kolkata") @db.VarChar(100)
  workStartTime              String?                @default("09:00") @map("work_start_time") @db.VarChar(20)
  workEndTime                String?                @default("18:00") @map("work_end_time") @db.VarChar(20)
  workingDays                String?                @map("working_days")
  shiftTiming                String?                @default("General Shift") @map("shift_timing") @db.VarChar(100)
  breakDurationMinutes       Int?                   @default(60) @map("break_duration_minutes")
  enableGlobalRemarks        Boolean                @default(false) @map("enable_global_remarks")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  selectedGlobalRemarkIds    String?                @default("ALL") @map("selected_global_remark_ids")
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessUnits              BusinessUnit[]
  candidates                 Candidate[]
  clients                    Client[]
  customRoles                CustomRole[]
  outgoingDelegationRequests JobDelegationRequest[] @relation("DelegationSourceBranch")
  incomingDelegationRequests JobDelegationRequest[] @relation("DelegationTargetBranch")
  jobs                       Job[]
  pods                       Pod[]
  userInvitations            UserInvitation[]
  users                      User[]
  managers                   User[]                 @relation("BranchManagers")

  @@unique([tenantId, name])
  @@map("branches")
  @@schema("ats")
}

model BusinessUnit {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String                 @map("tenant_id") @db.Uuid
  name                       String                 @db.VarChar(255)
  code                       String?                @db.VarChar(50)
  market                     String                 @default("US") @db.VarChar(50)
  currency                   String                 @default("USD") @db.VarChar(10)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branchId                   String?                @map("branch_id") @db.Uuid
  shiftTiming                String?                @default("General Shift") @map("shift_timing") @db.VarChar(100)
  timezone                   String?                @default("Asia/Kolkata") @db.VarChar(100)
  workEndTime                String?                @default("18:00") @map("work_end_time") @db.VarChar(20)
  workStartTime              String?                @default("09:00") @map("work_start_time") @db.VarChar(20)
  breakDurationMinutes       Int?                   @default(60) @map("break_duration_minutes")
  workingDays                String[]               @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"]) @map("working_days")
  allowAll                   Boolean                @default(true) @map("allow_all")
  allowNone                  Boolean                @default(false) @map("allow_none")
  allowPods                  Boolean                @default(true) @map("allow_pods")
  allowUnassigned            Boolean                @default(true) @map("allow_unassigned")
  podDistributionStrategy    String                 @default("AUTO") @map("pod_distribution_strategy") @db.VarChar(50)
  jobCodePattern             String?                @map("job_code_pattern") @db.VarChar(200)
  marketSegmentId            String?                @map("market_segment_id") @db.Uuid
  address                    String?                @db.VarChar(500)
  city                       String?                @db.VarChar(100)
  state                      String?                @db.VarChar(100)
  zipCode                    String?                @map("zip_code") @db.VarChar(20)
  branch                     Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  marketSegment              MarketSegment?         @relation(fields: [marketSegmentId], references: [id])
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customRoles                CustomRole[]
  outgoingDelegationRequests JobDelegationRequest[] @relation("DelegationSourceUnit")
  incomingDelegationRequests JobDelegationRequest[] @relation("DelegationTargetUnit")
  jobs                       Job[]
  pods                       Pod[]
  users                      User[]
  admins                     User[]                 @relation("BusinessUnitAdmins")

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId])
  @@map("business_units")
  @@schema("ats")
}

model MarketSegment {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  name             String         @db.VarChar(100)
  code             String         @db.VarChar(20)
  description      String?        @db.VarChar(500)
  defaultCurrency  String         @default("USD") @map("default_currency") @db.VarChar(10)
  defaultTimezone  String         @default("America/New_York") @map("default_timezone") @db.VarChar(100)
  defaultShift     String         @default("General Shift") @map("default_shift") @db.VarChar(100)
  defaultStartTime String?        @default("09:00") @map("default_start_time") @db.VarChar(20)
  defaultEndTime   String?        @default("18:00") @map("default_end_time") @db.VarChar(20)
  isActive         Boolean        @default(true) @map("is_active")
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessUnits    BusinessUnit[]
  tenant           Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("market_segments")
  @@schema("ats")
}

model SystemRole {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @unique @db.VarChar(100)
  systemKey       String           @unique @map("system_key") @db.VarChar(50)
  description     String?
  permissions     Json             @default("[]")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customRoles     CustomRole[]     @relation("SystemRoleCustomRoles")
  userInvitations UserInvitation[]

  @@map("system_roles")
  @@schema("ats")
}

model CustomRole {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  branchId        String?          @map("branch_id") @db.Uuid
  name            String           @db.VarChar(100)
  description     String?
  isSystem        Boolean          @default(false) @map("is_system")
  baseRoleId      String?          @map("base_role_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid
  systemRoleId    String?          @map("system_role_id") @db.Uuid
  permissions     Json             @default("[]")
  businessUnitId  String?          @map("business_unit_id") @db.Uuid
  baseRole        CustomRole?      @relation("BaseRoleCustomRoles", fields: [baseRoleId], references: [id])
  derivedRoles    CustomRole[]     @relation("BaseRoleCustomRoles")
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  businessUnit    BusinessUnit?    @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  systemRole      SystemRole?      @relation("SystemRoleCustomRoles", fields: [systemRoleId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userInvitations UserInvitation[]
  users           User[]

  @@map("custom_roles")
  @@schema("ats")
}

model Pod {
  id                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                   String                 @map("tenant_id") @db.Uuid
  branchId                   String?                @map("branch_id") @db.Uuid
  name                       String                 @db.VarChar(255)
  podHeadId                  String?                @map("pod_head_id") @db.Uuid
  description                String?
  isAvailableForAssignment   Boolean                @default(true) @map("is_available_for_assignment")
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessUnitId             String?                @map("business_unit_id") @db.Uuid
  jobAssignmentLogs          JobAssignmentLog[]
  assignedDelegationRequests JobDelegationRequest[]
  jobPods                    JobPod[]
  branch                     Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  businessUnit               BusinessUnit?          @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)
  podHead                    User?                  @relation("PodHead", fields: [podHeadId], references: [id])
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userInvitations            UserInvitation[]
  users                      User[]                 @relation("UserPod")

  @@map("pods")
  @@schema("ats")
}

model User {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String                    @map("tenant_id") @db.Uuid
  keycloakId           String?                   @unique @map("keycloak_id") @db.VarChar(255)
  email                String                    @db.VarChar(255)
  firstName            String?                   @map("first_name") @db.VarChar(128)
  lastName             String?                   @map("last_name") @db.VarChar(128)
  fullName             String                    @map("full_name") @db.VarChar(255)
  isActive             Boolean                   @default(true) @map("is_active")
  isApproved           Boolean                   @default(true) @map("is_approved")
  profilePicture       String?                   @map("profile_picture")
  roleId               String?                   @map("role_id") @db.Uuid
  assignedRoleIds      String[]                  @default([]) @map("assigned_role_ids") @db.Uuid
  branchId             String?                   @map("branch_id") @db.Uuid
  businessUnitId       String?                   @map("business_unit_id") @db.Uuid
  jobReviewerId        String?                   @map("job_reviewer_id") @db.Uuid
  podId                String?                   @map("pod_id") @db.Uuid
  lastLoginAt          DateTime?                 @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  notifications        Notification[]
  podsAsHead           Pod[]                     @relation("PodHead")
  notificationSettings UserNotificationSettings?
  branch               Branch?                   @relation(fields: [branchId], references: [id])
  businessUnit         BusinessUnit?             @relation(fields: [businessUnitId], references: [id])
  jobReviewer          User?                     @relation("ReviewerUsers", fields: [jobReviewerId], references: [id])
  reviewedUsers        User[]                    @relation("ReviewerUsers")
  pod                  Pod?                      @relation("UserPod", fields: [podId], references: [id])
  customRole           CustomRole?               @relation(fields: [roleId], references: [id])
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  managedBranches      Branch[]                  @relation("BranchManagers")
  administeredUnits    BusinessUnit[]            @relation("BusinessUnitAdmins")

  @@unique([tenantId, email])
  @@map("users")
  @@schema("ats")
}

model UserInvitation {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String      @map("tenant_id") @db.Uuid
  email           String      @db.VarChar(255)
  fullName        String?     @map("full_name") @db.VarChar(255)
  roleId          String?     @map("role_id") @db.Uuid
  branchId        String?     @map("branch_id") @db.Uuid
  podId           String?     @map("pod_id") @db.Uuid
  invitationToken String      @unique @map("invitation_token") @db.VarChar(255)
  tokenExpiresAt  DateTime    @map("token_expires_at") @db.Timestamptz(6)
  createdBy       String?     @map("created_by") @db.VarChar(255)
  isAccepted      Boolean     @default(false) @map("is_accepted")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  systemRoleId    String?     @map("system_role_id") @db.Uuid
  branch          Branch?     @relation(fields: [branchId], references: [id])
  pod             Pod?        @relation(fields: [podId], references: [id])
  customRole      CustomRole? @relation(fields: [roleId], references: [id])
  systemRole      SystemRole? @relation(fields: [systemRoleId], references: [id])
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("user_invitations")
  @@schema("ats")
}

model Client {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  clientCode          String?   @map("client_code") @db.VarChar(100)
  clientName          String    @map("client_name") @db.VarChar(255)
  contactNumber       String?   @map("contact_number") @db.VarChar(100)
  website             String?   @db.VarChar(255)
  industry            String?   @db.VarChar(100)
  state               String?   @db.VarChar(100)
  city                String?   @db.VarChar(100)
  status              String    @default("Active") @db.VarChar(50)
  category            String?   @db.VarChar(100)
  primaryOwner        String?   @map("primary_owner") @db.VarChar(255)
  businessUnit        String?   @map("business_unit") @db.VarChar(100)
  ownership           String?   @db.VarChar(100)
  displayOnJobPosting Boolean   @default(true) @map("display_on_job_posting")
  createdBy           String?   @map("created_by") @db.VarChar(255)
  modifiedBy          String?   @map("modified_by") @db.VarChar(255)
  federalId           String?   @map("federal_id") @db.VarChar(100)
  emailId             String?   @map("email_id") @db.VarChar(255)
  fax                 String?   @db.VarChar(100)
  paymentTerms        String?   @map("payment_terms") @db.VarChar(100)
  address             String?
  clientLead          String?   @map("client_lead") @db.VarChar(255)
  postalCode          String?   @map("postal_code") @db.VarChar(50)
  country             String?   @db.VarChar(100)
  practice            String?   @db.VarChar(100)
  requiredDocuments   String?   @map("required_documents")
  tag                 String?   @db.VarChar(100)
  clientShortName     String?   @map("client_short_name") @db.VarChar(100)
  geopoliticalZone    String?   @map("geopolitical_zone") @db.VarChar(100)
  primaryBusinessUnit String?   @map("primary_business_unit") @db.VarChar(100)
  facilityManagement  String?   @map("facility_management") @db.VarChar(100)
  branchId            String?   @map("branch_id") @db.Uuid
  market              String    @default("US") @map("market") @db.VarChar(50)
  endClientName       String?   @map("end_client_name") @db.VarChar(255)
  isSameAsPrimary     Boolean   @default(true) @map("is_same_as_primary")
  contactPerson       String?   @map("contact_person") @db.VarChar(255)
  contactDesignation  String?   @map("contact_designation") @db.VarChar(255)
  gstin               String?   @db.VarChar(100)
  panNumber           String?   @map("pan_number") @db.VarChar(100)
  currency            String    @default("USD") @db.VarChar(20)
  tierRating          String?   @map("tier_rating") @db.VarChar(50)
  creditCheckStatus   String?   @map("credit_check_status") @db.VarChar(50)
  fillabilityScore    String?   @map("fillability_score") @db.VarChar(50)
  vettingNotes        String?   @map("vetting_notes")
  onboardingStatus    String    @default("ACTIVE") @map("onboarding_status") @db.VarChar(50)
  msaSigned           Boolean   @default(false) @map("msa_signed")
  sowExecuted         Boolean   @default(false) @map("sow_executed")
  coiReceived         Boolean   @default(false) @map("coi_received")
  vendorPortalCreated Boolean   @default(false) @map("vendor_portal_created")
  stopNotifications   Boolean   @default(false) @map("stop_notifications")
  aboutCompany        String?   @map("about_company")
  approvalStatus      String?   @default("APPROVED") @map("approval_status") @db.VarChar(50)
  assignedApproverId  String?   @map("assigned_approver_id") @db.Uuid
  approvedBy          String?   @map("approved_by") @db.VarChar(255)
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectionReason     String?   @map("rejection_reason")
