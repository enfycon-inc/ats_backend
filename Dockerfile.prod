# ─── Stage 1: Build ─────────────────────────────────────────────────
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# Generate Prisma client from schema
RUN npx prisma generate

RUN npm run build

# ─── Stage 2: Production ────────────────────────────────────────────
FROM node:20-alpine AS production

WORKDIR /app

ENV NODE_ENV=production
LABEL io.ats.graceful-shutdown="true"

COPY package*.json ./
RUN npm install --omit=dev

# Copy Prisma schema and generated client
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=build /app/node_modules/@prisma ./node_modules/@prisma

COPY --from=build /app/dist ./dist

EXPOSE 5000

# Apply reviewed migrations separately before deployment; startup never synchronizes schema.
CMD ["sh", "-c", "if [ -f dist/main.js ]; then exec node dist/main.js; else exec node dist/src/main.js; fi"]


